{
  "cleanUrls": true,
  "github": { "enabled": false },
  "functions": {
    "api/campaigns/index.js": { "maxDuration": 60 },
    "api/campaigns/[id].js":  { "maxDuration": 60 },
    "api/contacts/index.js":  { "maxDuration": 60 },
    "api/lists/index.js":     { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/webhooks", "destination": "/api/track" },
    { "source": "/api/preview", "destination": "/api/track?action=preview" },
    { "source": "/v/:id/:token", "destination": "/api/track?action=preview&id=:id&token=:token" },
    { "source": "/api/campaigns/:id", "destination": "/api/campaigns?id=:id" },
    { "source": "/api/lists/:id", "destination": "/api/lists?id=:id" },
    { "source": "/api/ai/image-to-mjml", "destination": "/api/templates?action=image-to-mjml" },
    { "source": "/api/cron", "destination": "/api/campaigns?action=process-scheduled" },
    { "source": "/api/cron/import", "destination": "/api/contacts?action=import_process" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/(email|index|email.html|index.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdn.sheetjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://cdn.tailwindcss.com https://cdn.sheetjs.com; frame-src 'self' data:; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/social/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type" }
      ]
    }
  ]
}
