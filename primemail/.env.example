APP_NAME="Caetano PrimeMail"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Lisbon

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

# ── Hashing (Argon2id) ─────────────────────────────────────────────────────
ARGON_MEMORY=65536
ARGON_THREADS=2
ARGON_TIME=4

# ── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de Dados (MySQL) ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=primemail
DB_USERNAME=primemail
DB_PASSWORD=secret

# ── Sessões (Redis) ─────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ── Cache e Filas (Redis) ───────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Horizon ─────────────────────────────────────────────────────────────────
HORIZON_NAME="Caetano PrimeMail"
HORIZON_PREFIX=primemail_horizon:

# ── Email Transacional ──────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@caetanoprimemail.pt"
MAIL_FROM_NAME="Caetano PrimeMail"

# ── Storage S3 (MinIO local / AWS S3 produção) ─────────────────────────────
FILESYSTEM_CLOUD=s3
AWS_ACCESS_KEY_ID=primemail
AWS_SECRET_ACCESS_KEY=primemail_secret
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=primemail
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── MJML (compilação de templates de email) ───────────────────────────────
# Binário instalado no container PHP (ver docker/php/Dockerfile)
MJML_BINARY=mjml
MJML_TIMEOUT=30
MJML_MINIFY=true
MJML_CACHE_MINUTES=60

# ── Mailgun (envio de campanhas — preencher em produção) ───────────────────
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=

# ── Sentry (preencher em produção) ─────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Vite ────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
